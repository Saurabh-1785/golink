# GoLink configuration template.
#   cp .env.example .env
# then fill in your values.
#
# Used by:
#   - docker compose: reads .env automatically (see docker-compose.yml)
#   - go run:         main.go and analytics-service/main.go load .env at startup
# Real environment variables always take priority over this file.

# ---- Gemini AI (optional) ----
# Needed only for POST /suggest-slugs, which returns 503 without it.
# Get a key at https://aistudio.google.com/apikey
GEMINI_API_KEY=

# ---- URL service ----
PORT=8080
# Public prefix of generated short links, no trailing slash.
BASE_URL=http://localhost:8080

# ---- PostgreSQL ----
# Docker creates the database with these values only when the volume is empty.
# Changing them later requires changing them in Postgres too (or a fresh volume).
DB_USER=golink
DB_PASSWORD=change-me
DB_NAME=golink
DB_PORT=5432
# DB_HOST is only used for `go run`; Docker always uses the "postgres" service.
DB_HOST=localhost

# ---- Redis ----
# Only used for `go run`; Docker always uses redis:6379.
REDIS_ADDR=localhost:6379

# ---- Analytics gRPC service ----
GRPC_PORT=50051
# Only used for `go run`; Docker always uses analytics-service:<GRPC_PORT>.
ANALYTICS_GRPC_ADDR=localhost:50051
