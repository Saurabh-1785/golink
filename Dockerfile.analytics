# Dockerfile for the Analytics gRPC Service
FROM golang:1.21-alpine AS builder

WORKDIR /app
COPY go.mod ./
RUN go mod download || true

COPY . .
RUN go mod tidy && go build -o analytics-service ./analytics-service/main.go

# Final image
FROM alpine:latest
WORKDIR /app
COPY --from=builder /app/analytics-service .
EXPOSE 50051
CMD ["./analytics-service"]
